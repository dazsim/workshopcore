{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "${description}",
    "authors": [
        "${author}"
    ],
    "license": "All Rights Reserved",
    "accessWidener": "workshopcore.accesswidener",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.workshopcraft.workshopcore.fabric.WorkshopCoreFabric"
        ],
        "client": [
            "com.workshopcraft.workshopcore.fabric.WorkshopCoreFabricClient"
        ]
    },
    "mixins": [
        "workshopcore.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader}",
        "minecraft": "${minecraft}",
        "java": ">=${java}",
        "fabric-api": "*"
    }
}
